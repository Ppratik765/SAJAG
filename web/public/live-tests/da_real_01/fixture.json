  "segments": [
    {
      "index": 1,
      "text": "ओके",
      "audio_start_s": 0.0,
      "audio_end_s": 1.504,
      "appear_s": 1.581,
      "stt_latency_ms": 52
    },
    {
      "index": 2,
      "text": "क्या सहायता चाहिए पुलिस डिपार्टमेंट से आपको सर अभी पुलिस में ही बात हो रही थी उन्होंने बोला कि वो मेरा",
      "audio_start_s": 1.504,
      "audio_end_s": 8.02,
      "appear_s": 8.556,
      "stt_latency_ms": 112
    },
    {
      "index": 3,
      "text": "एफआईआर कैंसिल कर देंगे इसका आपका वीडियो स्टेटमेंट कार्ड होगा जी उसके बाद आपको",
      "audio_start_s": 8.02,
      "audio_end_s": 14.196,
      "appear_s": 16.057,
      "stt_latency_ms": 142
    },
    {
      "index": 4,
      "text": "जी मैं सिस्टम में चेक करता हूँ और ये अभी आपको कनेक्ट कर रहा हूँ",
      "audio_start_s": 14.196,
      "audio_end_s": 20.212,
      "appear_s": 20.769,
      "stt_latency_ms": 134
    },
    {
      "index": 5,
      "text": "वो आपका वॅन साइड वीडियो स्टेटमेंट रिकार्ड करेंगे",
      "audio_start_s": 20.212,
      "audio_end_s": 26.228,
      "appear_s": 26.751,
      "stt_latency_ms": 136
    },
    {
      "index": 6,
      "text": "ऑफिसर का कैमरा ऑफ होगा आपका कैमरा ऑन रहेगा जो एविडेन्स के तौर पर कोर्ट में सबमिट की जाएगी उसके बाद",
      "audio_start_s": 26.228,
      "audio_end_s": 32.244,
      "appear_s": 32.727,
      "stt_latency_ms": 85
    },
    {
      "index": 7,
      "text": "जी सर",
      "audio_start_s": 32.244,
      "audio_end_s": 35.668,
      "appear_s": 36.106,
      "stt_latency_ms": 56
    },
    {
      "index": 8,
      "text": "आप लाइन पे बने रहिये मैं आपको नाइट कर रहा हूँ",
      "audio_start_s": 35.668,
      "audio_end_s": 38.068,
      "appear_s": 38.546,
      "stt_latency_ms": 59
    },
    {
      "index": 9,
      "text": "प्रदीप सावंत कम इनटू माय ऑफिस केक",
      "audio_start_s": 38.068,
      "audio_end_s": 41.46,
      "appear_s": 41.928,
      "stt_latency_ms": 80
    },
    {
      "index": 10,
      "text": "कम इन कमिंग",
      "audio_start_s": 41.46,
      "audio_end_s": 44.136,
      "appear_s": 45.83,
      "stt_latency_ms": 73
    },
    {
      "index": 11,
      "text": "हेलो",
      "audio_start_s": 44.136,
      "audio_end_s": 45.864,
      "appear_s": 47.48,
      "stt_latency_ms": 54
    },
    {
      "index": 12,
      "text": "कम इन",
      "audio_start_s": 45.864,
      "audio_end_s": 48.668,
      "appear_s": 50.981,
      "stt_latency_ms": 57
    },
    {
      "index": 13,
      "text": "जी इनका वॅन सेकंड स्टेटमेंट रिकॉर्ड करो एस पर दी प्रोटोकॉल ओके सर",
      "audio_start_s": 48.668,
      "audio_end_s": 55.184,
      "appear_s": 58.394,
      "stt_latency_ms": 85
    },
    {
      "index": 14,
      "text": "मुझे उनकी तुरंत को चाहिए",
      "audio_start_s": 55.184,
      "audio_end_s": 57.584,
      "appear_s": 60.842,
      "stt_latency_ms": 126
    },
    {
      "index": 15,
      "text": "जय जय हिन्द सर पैसे वैसे नहीं चाहिए आपको",
      "audio_start_s": 57.584,
      "audio_end_s": 62.404,
      "appear_s": 66.295,
      "stt_latency_ms": 89
    }
  ],
