      "wall_arrival_s": 8.059
    },
    {
      "index": 2,
      "text": "सीबीआई मैंने जिंदगी में कोई गलत काम नहीं किया, आपके बैंक खाते से करोड़ों का अवैध लेन देन हुआ है",
      "duration_s": 6.048,
      "start_audio_s": 5.728,
      "end_audio_s": 11.776,
      "wall_arrival_s": 16.092
    },
    {
      "index": 3,
      "text": "सुप्रीम कोर्ट का गैर जमानती वारंट निकला है।",
      "duration_s": 3.04,
      "start_audio_s": 11.776,
      "end_audio_s": 14.816,
      "wall_arrival_s": 17.045
    },
    {
      "index": 4,
      "text": "सर मैं क्या करूँ, कृपया मदद कीजिए, तुरंत वीडियो कॉल चालू रखें, अपने घर वालों को मत बताना।",
      "duration_s": 6.08,
