# ==============================================================================
# Sajag Environment Configuration Reference (.env.example)
# All configuration variables and their one-line meanings.
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Gnani API Credentials & Speech Models
# ------------------------------------------------------------------------------
GNANI_API_KEY=                   # Gnani cloud API key from https://app.gnani.ai/voice (never commit!)
GNANI_TTS_MODEL=timbre-v2.5      # Gnani voice model for spoken warnings and explanation clips
STT_FORMAT=verbatim              # Speech-to-text formatting mode ("verbatim" or "transcribe")
STT_BIAS_ENABLED=false           # Whether to enable scam vocabulary biasing during STT recognition
STT_BIAS_SCORE=1.0               # Word biasing boost score when vocabulary biasing is active

# ------------------------------------------------------------------------------
# Server Network & Security Hardening
# ------------------------------------------------------------------------------
ENV=development                  # Runtime environment mode: "development" or "production"
ALLOWED_ORIGINS=http://localhost:3000  # Comma-separated allowed HTTP CORS and WebSocket Origin headers
ALLOW_NO_ORIGIN=true             # Allow WebSocket connections without Origin header (true in dev, false in prod)
TRUST_PROXY=false                # Whether to trust X-Forwarded-For header for client IP behind a reverse proxy
ADMIN_TOKEN=                     # Secret admin token required in X-Admin-Token header to access /api/usage
BUILD_COMMIT=dev                 # Short git commit hash of deployed build exposed on /api/meta
MAINTENANCE_MODE=false           # Set to true to return 503 maintenance on speech APIs while keeping text analysis operational

# ------------------------------------------------------------------------------
# Credit Budget & Session Caps (Launch Protection)
# ------------------------------------------------------------------------------
DAILY_STT_SECONDS_CAP=1800       # Maximum STT audio seconds allowed per calendar day before returning 503 budget_exhausted
DAILY_TTS_CHARS_CAP=20000        # Maximum TTS characters allowed per calendar day before returning 503 budget_exhausted
DAILY_LIVE_SESSIONS_CAP=50       # Maximum live audio streaming sessions allowed per calendar day
MAX_LIVE_SESSIONS=3              # Maximum concurrent live streaming sessions globally across the system
MAX_LIVE_SESSIONS_PER_IP=2       # Maximum concurrent live streaming sessions allowed from a single client IP
MAX_LIVE_SESSION_SECONDS=180     # Hard timeout limit in seconds for any single live audio session (3 minutes)
LIVE_IDLE_TIMEOUT_SECONDS=20     # Seconds of client audio silence or inactivity before closing WebSocket
LIVE_MAX_SPEECH_SECONDS=6.0      # Maximum chunk duration in seconds before forcing upstream VAD speech boundary
MAX_UPLOAD_SECONDS=180           # Maximum allowed duration in seconds for uploaded audio files on /api/analyze/audio

# ------------------------------------------------------------------------------
# Web Frontend Public Environment Variables (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000     # HTTP base URL for backend FastAPI endpoints
NEXT_PUBLIC_API_WS_URL=ws://localhost:8000   # WebSocket base URL for realtime audio streaming
NEXT_PUBLIC_SITE_URL=http://localhost:3000    # Canonical public URL of web application for OpenGraph cards
